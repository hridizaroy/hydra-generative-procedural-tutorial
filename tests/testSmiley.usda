#usda 1.0
(
    defaultPrim = "grinner"
    upAxis = "Z"
)

def Smiley "grinner"
{
    double eyeSize = 0.3
    double smile = 1.0
}

def Smiley "flatline" (
    doc = "A second smiley with smile = 0.5, a horizontal-line mouth."
)
{
    double eyeSize = 0.3
    double smile = 0.3
    double3 xformOp:translate = (2, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Smiley "sourpuss" (
    doc = "A third smiley with smile = 0, a frown, and smaller eyes."
)
{
    double eyeSize = 0.15
    double smile = 0.0
    double3 xformOp:translate = (4, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "targetSphereA"
{
    double radius = 1.0
    double3 xformOp:translate = (0, 10, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "targetSphereB"
{
    double radius = 1.0
    double3 xformOp:translate = (2, 10, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "targetSphereC"
{
    double radius = 1.0
    double3 xformOp:translate = (4, 10, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "targetSphereD" (
    doc = """Non-uniformly scaled sphere, to exercise the anchor xform
    composition when the target's local matrix isn't a pure rotation +
    translation."""
)
{
    double radius = 1.0
    double3 xformOp:translate = (6, 10, 0)
    double3 xformOp:scale = (2, 1, 0.5)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}

def Smiley "anchored" (
    doc = """Smiley anchored onto a sphere via target. Switch the
    'target' variant in usdview's variant editor to retarget between
    targetSphereA/B/C/D."""
    variantSets = ["target"]
    variants = {
        string target = "SphereA"
    }
)
{
    double eyeSize = 0.3
    double smile = 1.0

    color3f[] primvars:displayColor = [(1, 0, 0)]

    variantSet "target" = {
        "SphereA" {
            add rel target = </targetSphereA>
        }
        "SphereB" {
            add rel target = </targetSphereB>
        }
        "SphereC" {
            add rel target = </targetSphereC>
        }
        "SphereD" {
            add rel target = </targetSphereD>
        }
    }
}
